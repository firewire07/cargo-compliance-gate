# Local development placeholders only. Copy to .env (gitignored) and change if you want.
# These are not production credentials.

POSTGRES_USER=cargo
POSTGRES_PASSWORD=cargo
POSTGRES_DB=cargo_compliance

# Apps on the Mac use the external listener. Containers on the Compose network use kafka:9092.
KAFKA_BROKERS=127.0.0.1:9094
HOST=127.0.0.1

# Listen ports. shipment-svc uses PORT (default 3101) if you set it; leave it unset
# here so it cannot clash with GATEWAY_PORT. screening-svc uses SCREENING_SVC_PORT.
SCREENING_SVC_PORT=3102


# shipment-svc (Prisma). Same local Postgres as above.
DATABASE_URL=postgresql://cargo:cargo@127.0.0.1:5433/cargo_compliance

# screening-svc (Prisma). Same Postgres instance, separate database (avoids sharing _prisma_migrations with shipment-svc).
SCREENING_DATABASE_URL=postgresql://cargo:cargo@127.0.0.1:5433/cargo_compliance_screening

# shipment-svc hold module. Deadline for any missing screening result (fail closed).
HOLD_TIMEOUT_SECONDS=30
HOLD_SWEEP_INTERVAL_MS=2000

# api-gateway (JWT is a local placeholder only; never commit a real secret)
GATEWAY_PORT=3100
JWT_SECRET=change-me-local-only
JWT_EXPIRES_IN=2h
SHIPMENT_SVC_URL=http://127.0.0.1:3101
SCREENING_SVC_URL=http://127.0.0.1:3102

# Seeded demo users (passwords are also hardcoded in apps/api-gateway/src/auth/users.ts):
#   operator   / operator-demo    roles: OPERATOR
#   analyst-a  / analyst-a-demo   roles: ANALYST
#   analyst-b  / analyst-b-demo   roles: ANALYST

# screening-svc sanctions mode: name-only (default) or contextual.
SANCTIONS_MODE=name-only

# Optional directory for screening rule catalogs. Leave unset to use the app data folder.
# SCREENING_DATA_DIR=
