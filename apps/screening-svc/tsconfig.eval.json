{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": ["src/eval/**/*.ts", "src/rules/**/*.ts"]
}
